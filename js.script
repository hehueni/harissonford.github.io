/* =========================================================
   PORTFOLIO — Harisson Ford • script.js
   ========================================================= */
(() => {
  "use strict";

  const $ = (sel, ctx = document) => ctx.querySelector(sel);
  const $$ = (sel, ctx = document) => [...ctx.querySelectorAll(sel)];

  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  /* ---------- Header : fond au scroll + bouton retour en haut ---------- */
  const header = $("#header");
  const toTop = $("#to-top");

  const onScroll = () => {
    const y = window.scrollY;
    header.classList.toggle("scrolled", y > 30);
    toTop.classList.toggle("show", y > 500);
  };
  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  /* ---------- Menu mobile ---------- */
  const toggle = $("#nav-toggle");
  const menu = $("#nav-menu");

  const setMenu = (open) => {
    menu.classList.toggle("open", open);
    toggle.setAttribute("aria-expanded", String(open));
    toggle.innerHTML = open
      ? '<i class="fa-solid fa-xmark"></i>'
      : '<i class="fa-solid fa-bars"></i>';
  };

  toggle.addEventListener("click", () => setMenu(!menu.classList.contains("open")));
  $$(".nav-link").forEach((link) => link.addEventListener("click", () => setMenu(false)));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setMenu(false);
  });

  /* ---------- Lien actif selon la section visible ---------- */
  const sections = $$("main section[id]");
  const links = $$(".nav-link");

  const spy = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        links.forEach((l) =>
          l.classList.toggle("active", l.getAttribute("href") === "#" + entry.target.id)
        );
      });
    },
    { rootMargin: "-45% 0px -50% 0px" }
  );
  sections.forEach((s) => spy.observe(s));

  /* ---------- Effet machine à écrire ---------- */
  const typedEl = $("#typed");
  if (typedEl) {
    const words = JSON.parse(typedEl.dataset.words || "[]");

    if (reduceMotion || !words.length) {
      typedEl.textContent = words.join(" • ");
    } else {
      let w = 0;
      let i = 0;
      let deleting = false;

      const tick = () => {
        const word = words[w];
        typedEl.textContent = word.slice(0, i);

        let delay = deleting ? 45 : 95;

        if (!deleting && i === word.length) {
          delay = 1500;
          deleting = true;
        } else if (deleting && i === 0) {
          deleting = false;
          w = (w + 1) % words.length;
          delay = 350;
        }
        i += deleting ? -1 : 1;
        setTimeout(tick, delay);
      };
      tick();
    }
  }

  /* ---------- Apparition au scroll ---------- */
  const revealEls = $$(".reveal");

  if ("IntersectionObserver" in window && !reduceMotion) {
    const io = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add("visible");
          obs.unobserve(entry.target);
        });
      },
      { threshold: 0.12, rootMargin: "0px 0px -40px 0px" }
    );

    revealEls.forEach((el) => {
      // Décalage progressif pour les éléments d'une même grille
      const siblings = el.parentElement ? [...el.parentElement.children] : [];
      const index = siblings.indexOf(el);
      el.style.transitionDelay = Math.min(index, 4) * 0.09 + "s";
      io.observe(el);
    });
  } else {
    revealEls.forEach((el) => el.classList.add("visible"));
  }

  /* ---------- Formulaire de contact (ouvre le client mail) ---------- */
  const form = $("#contact-form");
  const status = $("#form-status");

  if (form) {
    form.addEventListener("submit", (e) => {
      e.preventDefault();

      const fields = [
        { el: $("#cf-name"), ok: (v) => v.length >= 2 },
        { el: $("#cf-email"), ok: (v) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v) },
        { el: $("#cf-message"), ok: (v) => v.length >= 5 },
      ];

      let valid = true;
      fields.forEach(({ el, ok }) => {
        const good = ok(el.value.trim());
        el.parentElement.classList.toggle("error", !good);
        if (!good) valid = false;
      });

      status.classList.remove("ok");
      if (!valid) {
        status.textContent = "Veuillez remplir correctement tous les champs.";
        return;
      }

      const name = $("#cf-name").value.trim();
      const email = $("#cf-email").value.trim();
      const message = $("#cf-message").value.trim();

      const subject = encodeURIComponent("Contact depuis le portfolio — " + name);
      const body = encodeURIComponent(message + "\n\n— " + name + " (" + email + ")");

      window.location.href = "mailto:hehueni@gmail.com?subject=" + subject + "&body=" + body;

      status.textContent = "Votre application mail va s'ouvrir pour envoyer le message.";
      status.classList.add("ok");
      form.reset();
    });
  }
})();
